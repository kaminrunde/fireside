{
  "name": "@kaminrunde/fireside-wrapper",
  "version": "1.2.0",
  "private": true,
  "packageManager": "yarn@4.19.0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "lerna": "^3.20.2"
  },
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "watch": "lerna run watch",
    "start:example": "lerna run start --scope='@kaminrunde/example-project-fireside'",
    "start:app": "lerna run start --scope='@kaminrunde/fireside-app'",
    "start:storybook": "lerna run storybook --scope='@kaminrunde/example-project-fireside'",
    "build:fireside": "lerna run fireside --scope='@kaminrunde/example-project-fireside'",
    "prepare-release": "git checkout master && git pull --rebase origin master && lerna changed",
    "release": "yarn run prepare-release && lerna version --exact",
    "prerelease": "lerna version prerelease"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaminrunde/fireside.git"
  }
}
